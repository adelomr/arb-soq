<?xml version="1.0" encoding="utf-8"?>
<androidx.drawerlayout.widget.DrawerLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/drawer_layout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_bg"
    tools:context=".MainActivity">

    <!-- Main Content -->
    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="16dp">

            <!-- 1. Hero Status Card (لوحة حالة السيرفر الرئيسية) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                app:cardCornerRadius="20dp"
                app:cardElevation="6dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:background="@drawable/bg_header_gradient"
                    android:padding="20dp">

                    <!-- Top Bar: Menu & App Title -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <ImageButton
                            android:id="@+id/buttonMenu"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_menu"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Menu"
                            app:tint="@color/white" />

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:layout_marginStart="12dp"
                            android:text="@string/app_name"
                            android:textColor="@color/white"
                            android:textSize="20sp"
                            android:textStyle="bold" />

                        <!-- Health Check Icon Button -->
                        <ImageButton
                            android:id="@+id/buttonHealth"
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:src="@drawable/ic_info"
                            android:background="?android:attr/selectableItemBackgroundBorderless"
                            android:contentDescription="Health Check"
                            app:tint="#94A3B8" />

                    </LinearLayout>

                    <!-- Server Status Badge -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:gravity="center"
                        android:layout_marginTop="16dp"
                        android:layout_marginBottom="16dp"
                        android:padding="12dp"
                        android:background="@drawable/bg_badge_status">

                        <TextView
                            android:id="@+id/textServerStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="🟢 الخادم جاهز ويعمل"
                            android:textColor="#38BDF8"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                    </LinearLayout>

                    <!-- Main Action Toggle Button -->
                    <Button
                        android:id="@+id/buttonToggleServer"
                        android:layout_width="match_parent"
                        android:layout_height="52dp"
                        android:text="@string/toggle_server"
                        android:textColor="@color/white"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_success"
                        android:stateListAnimator="@null" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 2. Quick Actions Grid (الإجراءات السريعة المنظمة) -->
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="الإجراءات السريعة"
                android:textColor="@color/text_secondary"
                android:textSize="14sp"
                android:textStyle="bold"
                android:layout_marginBottom="10dp"
                android:layout_marginStart="4dp" />

            <!-- Row 1: Test & Copy -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="10dp">

                <!-- Test SMS Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <Button
                        android:id="@+id/buttonTest"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="🚀  اختبار الإرسال"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_action"
                        android:stateListAnimator="@null" />

                </androidx.cardview.widget.CardView>

                <!-- Copy Endpoint Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <Button
                        android:id="@+id/buttonCopyEndpoint"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="📋  نسخ الرابط"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_action"
                        android:stateListAnimator="@null" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- Row 2: SIM Settings & Usage Stats -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginBottom="12dp">

                <!-- SIM Settings Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginEnd="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <Button
                        android:id="@+id/buttonSetDefaultSim"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="⚙️  إعداد الشريحة"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_action"
                        android:stateListAnimator="@null" />

                </androidx.cardview.widget.CardView>

                <!-- Stats Button -->
                <androidx.cardview.widget.CardView
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:layout_marginStart="6dp"
                    app:cardCornerRadius="16dp"
                    app:cardElevation="2dp"
                    app:cardBackgroundColor="@color/white">

                    <Button
                        android:id="@+id/buttonUsageStats"
                        android:layout_width="match_parent"
                        android:layout_height="64dp"
                        android:text="📊  الإحصائيات"
                        android:textColor="@color/text_primary"
                        android:textSize="14sp"
                        android:textStyle="bold"
                        android:background="@drawable/bg_btn_action"
                        android:stateListAnimator="@null" />

                </androidx.cardview.widget.CardView>

            </LinearLayout>

            <!-- 2.5 WhatsApp Business Control Card (بوابة واتساب أعمال) -->
            <androidx.cardview.widget.CardView
                android:id="@+id/cardWhatsAppStatus"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:clickable="true"
                android:focusable="true"
                android:foreground="?android:attr/selectableItemBackground"
                app:cardCornerRadius="16dp"
                app:cardElevation="2dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="💬  بوابة واتساب للأعمال"
                            android:textColor="@color/text_primary"
                            android:textSize="15sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/buttonTestWhatsApp"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="اختبار واتساب"
                            android:textColor="#059669"
                            android:textSize="12sp"
                            android:background="@drawable/bg_btn_action"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:stateListAnimator="@null" />

                    </LinearLayout>

                    <TextView
                        android:id="@+id/textWhatsAppStatus"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="🟢 خدمة الإرسال التلقائي عبر واتساب: مفعّلة"
                        android:textColor="@color/accent_green"
                        android:textSize="13sp"
                        android:layout_marginTop="8dp" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- 3. Recent SMS Activity Card (سجل الرسائل الأخير) -->
            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                app:cardCornerRadius="18dp"
                app:cardElevation="3dp"
                app:cardBackgroundColor="@color/white">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="16dp">

                    <!-- Header with Title and Clear Button -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:gravity="center_vertical"
                        android:layout_marginBottom="12dp">

                        <TextView
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="📨  سجل الرسائل المرسلة"
                            android:textColor="@color/text_primary"
                            android:textSize="16sp"
                            android:textStyle="bold" />

                        <Button
                            android:id="@+id/buttonClearLogs"
                            android:layout_width="wrap_content"
                            android:layout_height="36dp"
                            android:text="مسح السجل"
                            android:textColor="@color/accent_red"
                            android:textSize="12sp"
                            android:background="@drawable/bg_btn_action"
                            android:paddingStart="12dp"
                            android:paddingEnd="12dp"
                            android:stateListAnimator="@null" />

                    </LinearLayout>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:background="@color/divider"
                        android:layout_marginBottom="8dp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/recyclerView"
                        android:layout_width="match_parent"
                        android:layout_height="320dp"
                        android:nestedScrollingEnabled="true"
                        android:scrollbars="vertical" />

                </LinearLayout>
            </androidx.cardview.widget.CardView>

            <!-- Secondary / Advanced Actions (مخفية تلقائياً للحفاظ على النظافة والوصول إليها عبر القائمة) -->
            <LinearLayout
                android:id="@+id/hiddenSecondaryActions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <Button android:id="@+id/buttonTestSms" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonAdvancedTest" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonShowCode" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonCopyExamples" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonCheckServer" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonEditTemplate" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonSecuritySettings" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonSimStatus" android:layout_width="match_parent" android:layout_height="wrap_content" />
                <Button android:id="@+id/buttonBackgroundWork" android:layout_width="match_parent" android:layout_height="wrap_content" />

            </LinearLayout>

        </LinearLayout>

    </ScrollView>

    <!-- Navigation Drawer (القائمة الجانبية الأنيقة) -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/navigation_drawer"
        android:layout_width="280dp"
        android:layout_height="match_parent"
        android:layout_gravity="start"
        android:background="@color/white"
        android:paddingTop="56dp" />

</androidx.drawerlayout.widget.DrawerLayout>